.env
warehouse/*
!warehouse/.gitkeep
catalog/*
!catalog/.gitkeep
raw/*
!raw/.gitkeep
state/*
!state/.gitkeep
# C6.1: watermark/checkpoint/staleness + the S3 Iceberg catalog db are the
# durable state a CI runner restores via git checkout — they must be tracked.
!state/watermark.json
!state/backfill_checkpoint.json
!state/s3_catalog.db
!state/staleness.json
# C6.5: the DQ scorecard trend (the marts DuckDB isn't persisted across CI
# runs, so history can't live there). The .csv.tmp sibling — only present
# if a run crashed exactly at the atomic rename — stays ignored by state/*.
!state/scorecard_history.csv
*.duckdb
*.duckdb.wal
!dashboard/sources/openledger/openledger.duckdb
__pycache__/
*.pyc
.venv/
.venv-soda/
target/
logs/
dbt_packages/
.user.yml
.DS_Store

# Phase 5 — dashboard/: node_modules and Evidence's own build artifacts are
# reproducible from package.json + sources/, so not committed. The pruned
# openledger.duckdb (~2MB, exception above) and package-lock.json ARE
# committed — the whole point of C5.1 is that the data path is small enough
# to commit, and the lockfile is what makes Vercel's install reproducible.
dashboard/node_modules/
dashboard/.evidence/
dashboard/build/
